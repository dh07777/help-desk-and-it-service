# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-this-in-production-supportdesk-2026

# Database
DATABASE_URL=sqlite:///supportdesk.db

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# SMTP / Email Notifications (Optional - will log to console/mock if not enabled)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=supportdesk-alerts@company.local
MAIL_ENABLED=False
